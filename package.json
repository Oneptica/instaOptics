{
  "name": "instaoptics",
  "productName": "instaOptics",
  "version": "0.1.5",
  "private": true,
  "description": "instaOptics optical simulation software",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "native": "node scripts/build-native.mjs",
    "native:release": "node scripts/build-native.mjs --release",
    "dev": "npm run native && node scripts/electron-vite.mjs dev",
    "start": "node scripts/electron-vite.mjs preview",
    "build": "npm run typecheck && npm run native:release && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "cargo test --workspace && vitest run",
    "test:ui": "vitest run",
    "dist": "npm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vscode/codicons": "^0.0.46-24",
    "dockview-react": "^8.4.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.185.1",
    "typescript": "~6.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "author": "Oneptica",
  "homepage": "https://github.com/Oneptica/instaOptics",
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
